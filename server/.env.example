# MedTrace Server Environment
# Copy this file to .env and fill in values

MONGO_URI=mongodb://localhost:27017/medtrace
JWT_SECRET=medtrace-jwt-secret-change-in-production
JWT_REFRESH_SECRET=medtrace-refresh-secret-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
PORT=3001

# Gemini API (for AI medication assistant)
GEMINI_API_KEY=

# Node environment
NODE_ENV=development
